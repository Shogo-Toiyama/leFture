# Experiment results (contents_generation/test_codes/*/results/) ARE committed, after
# `python3 tools/experiment_privacy/check_results.py` passes. Raw inputs stay ignored.
# Results that hold content of people outside tools/experiment_privacy/allowlist.json
# go to the private repo and are listed here instead. See AGENTS.md.
contents_generation/test_codes/haiku_migration_tone/inputs/
contents_generation/test_codes/gemini4_hydrogen_swap/inputs/

# router_language_eval: cases/ are raw production chats (inputs). Results are committed after the privacy check.
contents_generation/test_codes/router_language_eval/cases/

# range_overview_eval: patched/ holds copies of production files. Results are committed after the privacy check.
contents_generation/test_codes/range_overview_eval/patched/

# deepnote_readability / funfact_readability: inputs hold production transcripts and student profiles
contents_generation/test_codes/deepnote_readability/inputs/
contents_generation/test_codes/funfact_readability/inputs/

# graphify: machine-specific paths, personal token log and regenerable cache (graph.json / GRAPH_REPORT.md / manifest.json / graph.html are committed)
graphify-out/cache/
graphify-out/.graphify_*
graphify-out/cost.json
